[Unit]
Description=nutwake: UPS shutdown helper, Wake-on-LAN and status page
After=network-online.target nut-server.service
Wants=network-online.target

[Service]
Type=simple
User=nutwake
Group=nutwake
ExecStart=/usr/local/bin/nutwake serve -config /etc/nutwake/config.yaml
Restart=on-failure
RestartSec=5s

# The history lives here; systemd creates it for the nutwake user. The shutdown
# helper runs as root from upsmon and writes into it too.
StateDirectory=nutwake
StateDirectoryMode=0755

# Pinging the nodes needs raw sockets. Nothing else does.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
